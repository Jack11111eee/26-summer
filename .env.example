# 复制为 .env 并填写真实值（.env 已被 .gitignore 忽略，勿入库）

# ---- LLM ----
# deepseek | mock（mock 用规则模拟 LLM 输出，离线可跑通全流程）
LLM_PROVIDER=mock
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=

# ---- 首个 admin 种子账号（scripts.seed_admin 读取）----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---- JWT ----
JWT_SECRET=change-me-in-.env
